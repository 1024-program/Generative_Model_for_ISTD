{
    "name": "irstd",
    "phase": "val", // train or val
    "gpu_ids": [
        0
    ],
    "path": { //set the path
        "log": "logs",
        "tb_logger": "tb_logger",
        "results": "results",
        "checkpoint": "checkpoint",
        // "resume_state": null,
        "detection_state": "mIoU__DNANet_NUDT-SIRST_epoch.pth.tar" ,
        "resume_state": "experiments/irstd_241217_190236/checkpoint/I200000_E4762" //pretrain model or training state
    },
    "datasets": {
        "train": {
            "name": "NUDT-SIRST",
            "mode": "HR", // whether need LR img
            "dataroot": "dataset/NUDT-SIRST/train",
            "datatype": "img", //lmdb or img, path of img files
            "l_resolution": 256, // low resolution need to super_resolution
            "r_resolution": 256, // high resolution
            "batch_size": 4,
            "num_workers": 8,
            "use_shuffle": true,
            "data_len": -1 // -1 represents all data used in train
        },
        "val": {
            "name": "NUDT-SIRST",
            "mode": "HR",
            "dataroot": "dataset/NUDT-SIRST/test",
            "datatype": "img", //lmdb or img, path of img files
            "l_resolution": 256,
            "r_resolution": 256,
            "data_len": -1 // data length in validation
        }
    },
    "model": {
        "which_model_G": "sr3", // use the ddpm or sr3 network structure
        "finetune_norm": false,
        "unet": {
            "in_channel": 4,
            "out_channel": 1,
            "inner_channel": 16,
            "channel_multiplier": [
                1,
                2,
                4,
                8,
                16
            ],
            "attn_res": [
                16
            ],
            "res_blocks": 2,
            "dropout": 0.2,
            "norm_groups": 16,
            "deep_supervision": true,
            "nb_filter": [16,32,64,128,256]
        },
        "beta_schedule": { // use munual beta_schedule for acceleration
            "train": {
                "schedule": "linear",
                "n_timestep": 500,
                "linear_start": 1e-6,
                "linear_end": 4e-2
            },
            "val": {
                "schedule": "linear",
                "n_timestep": 500,
                "linear_start": 1e-6,
                "linear_end": 4e-2
            }
        },
        "diffusion": {
            "image_size": 256,
            "channels": 1, //sample channel
            "conditional": true // unconditional generation or unconditional generation(super_resolution)
        }
    },
    "train": {
        "n_iter": 1000000,
        "val_freq": 1e4,
        "save_checkpoint_freq": 50000,
        "print_freq": 20,
        "optimizer": {
            "type": "adam",
            "lr": 1e-4
        },
        "ema_scheduler": { // not used now
            "step_start_ema": 5000,
            "update_ema_every": 1,
            "ema_decay": 0.9999
        }
    },
    "wandb": {
        "project": "irstd"
    }
}